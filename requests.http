###############################################################################
# Task Platform - request collection
#
# Every endpoint in the API, plus one request per error code. Open in VS Code
# with the REST Client extension and click "Send Request", or copy any block
# into curl. No Postman import, no signup, no JSON file to keep in sync.
#
# Prerequisites:  npm run db:up && npm run migration:run && npm run seed && npm run dev
###############################################################################

@host = http://localhost:3000/api

# Seeded by `npm run seed` - stable ids on purpose.
@ada   = 11111111-1111-4111-8111-111111111111
@grace = 22222222-2222-4222-8222-222222222222
@alan  = 33333333-3333-4333-8333-333333333333

# Set this from the id returned by "Create a task" below.
@taskId = paste-an-id-here


###############################################################################
# Metadata - the request that makes the client type-agnostic
###############################################################################

### Every task type, its statuses, and the fields required to enter each one.
# This is the entire contract between server and client for forms. Adding a task
# type changes this response and nothing else.
GET {{host}}/task-types

### The seeded users, for assignee pickers.
GET {{host}}/users

### Liveness plus a live database probe. 200 ok / 503 degraded.
GET {{host}}/health


###############################################################################
# The happy path - a procurement task from creation to closure
###############################################################################

### 1. Create. 201, status 1, version 1. Creation collects no data (WF-3a).
POST {{host}}/tasks
Content-Type: application/json

{ "type": "PROCUREMENT", "assignedUserId": "{{ada}}" }

### 2. Advance to status 2 and hand it to Grace.
# Direction is derived from toStatus, never declared. expectedVersion is optional
# but sent here: it says "I was looking at v1 when I decided this" (ADR-015).
POST {{host}}/tasks/{{taskId}}/transitions
Content-Type: application/json

{
  "toStatus": 2,
  "assignedUserId": "{{grace}}",
  "data": { "quotes": ["Supplier A - 100", "Supplier B - 90"] },
  "expectedVersion": 1
}

### 3. Advance to the final status.
POST {{host}}/tasks/{{taskId}}/transitions
Content-Type: application/json

{
  "toStatus": 3,
  "assignedUserId": "{{grace}}",
  "data": { "receipt": "INV-2026-001" },
  "expectedVersion": 2
}

### 4. Close. Permitted only at the final status, and it names no assignee -
# closing is a state change, not a status change (ADR-011).
POST {{host}}/tasks/{{taskId}}/close
Content-Type: application/json

{}

### 5. The task with its full history: CREATE, FORWARD, FORWARD, CLOSE.
GET {{host}}/tasks/{{taskId}}

### Tasks held by Grace - open and closed by default (ADR-012).
GET {{host}}/users/{{grace}}/tasks

### Narrowed to one state.
GET {{host}}/users/{{grace}}/tasks?state=OPEN


###############################################################################
# Backward moves - create a fresh task and run it to status 3 first
###############################################################################

### Send it back to status 2. No data: what status 2 needs was collected on the
# way up. Everything gathered for status 3 is cleared (WF-7b), but the history
# rows are untouched - check GET /tasks/:id afterwards.
POST {{host}}/tasks/{{taskId}}/transitions
Content-Type: application/json

{ "toStatus": 2, "assignedUserId": "{{alan}}" }

### Straight back to status 1. Backward moves may span any distance (WF-5).
POST {{host}}/tasks/{{taskId}}/transitions
Content-Type: application/json

{ "toStatus": 1, "assignedUserId": "{{ada}}" }


###############################################################################
# Every error code in the contract
###############################################################################

### 400 BAD_REQUEST - not valid JSON.
POST {{host}}/tasks
Content-Type: application/json

{ "type":

### 400 BAD_REQUEST - a required field is missing. `details` names it.
POST {{host}}/tasks
Content-Type: application/json

{ "type": "PROCUREMENT" }

### 400 BAD_REQUEST - a key the endpoint never declared. Not silently dropped.
POST {{host}}/tasks
Content-Type: application/json

{ "type": "PROCUREMENT", "assignedUserId": "{{ada}}", "priority": "high" }

### 400 BAD_REQUEST - an id that is not a uuid, rejected before it reaches Postgres.
GET {{host}}/tasks/not-a-uuid

### 400 BAD_REQUEST - an unrecognised filter value, rejected rather than ignored.
GET {{host}}/users/{{ada}}/tasks?state=ARCHIVED

### 400 BAD_REQUEST - `data` is not an object. That is shape, not content.
POST {{host}}/tasks/{{taskId}}/transitions
Content-Type: application/json

{ "toStatus": 2, "assignedUserId": "{{ada}}", "data": "quotes" }

### 404 NOT_FOUND - a task type that is not registered. The value is deliberately
# implausible: naming a type you intend to ship makes the example expire the day
# it ships.
POST {{host}}/tasks
Content-Type: application/json

{ "type": "NO_SUCH_TASK_TYPE", "assignedUserId": "{{ada}}" }

### 404 NOT_FOUND - a user who does not exist.
GET {{host}}/users/99999999-9999-4999-8999-999999999999/tasks

### 404 NOT_FOUND - no route matches. Same envelope as everything else.
GET {{host}}/nope

### 422 VALIDATION_FAILED - a legal move, entered without the data the status
# requires. Compare with the 400s above: this body parsed perfectly.
POST {{host}}/tasks/{{taskId}}/transitions
Content-Type: application/json

{ "toStatus": 2, "assignedUserId": "{{ada}}" }

### 422 VALIDATION_FAILED - the right field, the wrong shape. Procurement wants
# exactly two quotes. `details[0].path` is `data.quotes`.
POST {{host}}/tasks/{{taskId}}/transitions
Content-Type: application/json

{ "toStatus": 2, "assignedUserId": "{{ada}}", "data": { "quotes": ["only one"] } }

### 409 INVALID_TRANSITION - skipping a status. Forward moves are exactly +1 (WF-4).
POST {{host}}/tasks/{{taskId}}/transitions
Content-Type: application/json

{ "toStatus": 3, "assignedUserId": "{{ada}}", "data": { "receipt": "INV-1" } }

### 409 INVALID_TRANSITION - out of range. The bound comes from the type's own
# ladder, so the message says "1..3" without anyone hard-coding 3.
POST {{host}}/tasks/{{taskId}}/transitions
Content-Type: application/json

{ "toStatus": 99, "assignedUserId": "{{ada}}" }

### 409 INVALID_TRANSITION - closing before the final status (WF-6).
POST {{host}}/tasks/{{taskId}}/close
Content-Type: application/json

{}

### 409 TASK_CLOSED - any move on a closed task (WF-2). Run step 4 first.
POST {{host}}/tasks/{{taskId}}/transitions
Content-Type: application/json

{ "toStatus": 2, "assignedUserId": "{{ada}}" }

### 409 VERSION_CONFLICT - acting on a version that has since moved.
# Send this twice: the first succeeds, the second is refused (ADR-015).
POST {{host}}/tasks/{{taskId}}/transitions
Content-Type: application/json

{
  "toStatus": 2,
  "assignedUserId": "{{ada}}",
  "data": { "quotes": ["Supplier A - 100", "Supplier B - 90"] },
  "expectedVersion": 1
}
