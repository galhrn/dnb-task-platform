{
  "name": "@task-platform/api",
  "version": "0.1.0",
  "private": true,
  "description": "Task platform HTTP API",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run --config vitest.int.config.ts",
    "migration:run": "tsx src/infrastructure/db/migrate.ts",
    "migration:revert": "tsx src/infrastructure/db/migrate.ts --revert",
    "seed": "tsx src/infrastructure/db/seeds/seed-users.ts"
  },
  "dependencies": {
    "@task-platform/contracts": "*",
    "dotenv": "17.4.2",
    "express": "4.22.2",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "typeorm": "0.3.31",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "4.17.25"
  }
}
