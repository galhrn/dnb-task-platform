{
  "name": "task-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Extensible task management platform - npm workspaces root",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @task-platform/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:int": "npm run test:int --workspaces --if-present",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "migration:run": "npm run migration:run --workspace @task-platform/api",
    "migration:revert": "npm run migration:revert --workspace @task-platform/api",
    "seed": "npm run seed --workspace @task-platform/api"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
